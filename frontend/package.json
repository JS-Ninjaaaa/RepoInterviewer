{
  "name": "repointerviewer",
  "publisher": "work-in-progress",
  "displayName": "Repointerviewer",
  "description": "技術面接の練習ができる拡張機能",
  "version": "0.0.1",
  "icon": "public/assets/images/icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/work-in-progress-team/RepoInterviewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./build/commands/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "repointerviewer.start",
        "title": "Repointerviewer: Start"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b src/commands src/webview",
    "pretest": "npm run compile && npm run lint",
    "format": "prettier --write src/",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "npm run commands:build && npm run vite:build",
    "commands:build": "tsc -p ./src/commands",
    "vite:build": "tsc && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "~18.19.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "prettier": "3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^5.0.10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.1.0",
    "@mui/material": "^7.1.0",
    "framer-motion": "^12.18.1",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.6.0"
  }
}
