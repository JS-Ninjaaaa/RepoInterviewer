{
  "compilerOptions": {
    "composite": true, // project references 用
    "target": "ESNext", // 最新のJS機能をターゲット
    "module": "ESNext", // ESM
    "jsx": "react-jsx", // React 17+ の自動 JSX
    "moduleResolution": "bundler", // Vite/Rollup 向け
    "esModuleInterop": true, // default import を許可
    "allowSyntheticDefaultImports": true, // 同上
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src", // ソースのルート
    "outDir": "../../build/webview", // ビルド成果物
    "baseUrl": ".",
    "paths": {            
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/types/*"]
    }
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "vite.config.ts", 
    "node_modules"
  ]
}
