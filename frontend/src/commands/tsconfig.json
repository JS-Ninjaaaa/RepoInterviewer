{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "outDir": "../../build/commands",
    "rootDir": "../",
    "baseUrl": "./src",
    "paths": {            
      "@/*": ["*"],
      "@shared/*": ["../../shared/types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../shared/types"
  ],
  "exclude": [
    "node_modules",
    "../../build"
  ]
}
