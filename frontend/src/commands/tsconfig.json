{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "outDir": "../../build",
    "rootDir": "../",
    "baseUrl": "../",
    "paths": {            
      "@/*": ["*"],
      "@shared/*": ["shared/types/*"]
    }
  },
  "include": [
    "../commands/**/*.ts",
    "../shared/types"
  ],
  "exclude": [
    "node_modules",
    "../../build"
  ]
}
