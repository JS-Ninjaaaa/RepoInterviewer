{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "outDir": "../../build/commands",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {            
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "../../build"
  ]
}
